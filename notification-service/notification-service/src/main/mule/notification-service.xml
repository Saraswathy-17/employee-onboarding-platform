    eventType: "EMPLOYEE_ONBOARDED",
    eventVersion: "1.0",
    employee: {
        employeeId: payload.employee_id,
        name: payload.name,
        salary: payload.salary,
        status: payload.status
    },
    notification: {
        "type": "ONBOARDING_SUCCESS",
        "message": "Employee onboarding completed successfully"
    }
}]]></ee:set-payload>
			</ee:message>

	<flow name="employee-process-api-v2Flow" doc:id="dec6209f-ce42-4982-b7fa-22b258c7fbc3" >
		<http:listener doc:name="Listener" doc:id="0e39a0d0-bcbc-4c33-a7cb-873a75513d2b" config-ref="HTTP_Listener_config" path="/onboarding/process">
			<http:response statusCode="#[vars.httpStatus default 200]" />
		</http:listener>
		<set-variable value="#[uuid()]" doc:name="Set Variable" doc:id="479d135d-ef1d-45eb-a14f-a2b38e1e0de3" variableName="correlationId"/>
		<set-variable value="#[payload]" doc:name="Set Variable" doc:id="71ae358f-8dfc-4229-a845-681cb861a650" variableName="originalRequest"/>
		<os:contains doc:name="Contains" doc:id="2571ef16-57a2-4d3b-8199-7012b58d6547" key="#[vars.originalRequest.employeeId]" objectStore="Object_store"/>
		<choice doc:name="Choice" doc:id="4c8a977f-e0ee-4e46-8efc-877f37d85bbe" >
			<when expression="#[vars.isDuplicate == false]">
				<raise-error doc:name="Raise error" doc:id="e8fc401c-db28-45f3-83fa-85bc10b9bd05" type="APP:DUPLICATE_EMPLOYEE" description="Employee already exists"/>
			</when>
			<otherwise >
				<http:request method="GET" doc:name="Request" doc:id="5557a5d2-eb64-44ac-84b7-a4f3fdeff4e9" config-ref="HTTP_Request_configuration" path="/hr/verify/{employeeId}" target="hrResponse">
					<http:uri-params ><![CDATA[#[output application/java
---
{
	employeeId :vars.originalRequest.employeeId
}]]]></http:uri-params>
				</http:request>
				<choice doc:name="Choice" doc:id="db422aeb-8549-46dc-83b0-267369d3cb3e" >
					<when expression="#[vars.hrResponse.eligible == true]">
						<raise-error doc:name="Raise error" doc:id="b8f84efa-71da-4bff-84a1-09c561fc5938" type="APP:INELIGIBLE_EMPLOYEE"/>
					</when>
					<otherwise >
						<set-variable value="#[vars.originalRequest.employmentType]" doc:name="Set Variable" doc:id="ca969dcf-919c-4081-ab88-5527beb4a490" variableName="employmentType"/>
						<ee:transform doc:name="Transform Message" doc:id="9af44acd-f144-4763-97b0-ec5f53628143" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
if (vars.employmentType == "FULL_TIME")
  ["healthInsurance", "providentFund", "annualBonus"]
else if (vars.employmentType == "CONTRACT")
  ["contractAllowance"]
else if (vars.employmentType == "INTERN")
  ["trainingAllowance"]
else
  []]]></ee:set-payload>
							</ee:message>
							<ee:variables >
								<ee:set-variable variableName="benefits" ><![CDATA[%dw 2.0
output application/json
---
if (vars.employmentType == "FULL_TIME")
  ["healthInsurance", "providentFund", "annualBonus"]
else if (vars.employmentType == "CONTRACT")
  ["contractAllowance"]
else if (vars.employmentType == "INTERN")
  ["trainingAllowance"]
else
  []]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<ee:transform doc:name="Transform Message" doc:id="dd916aff-2c1b-4680-9d3b-6cd4ee61fd7f" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  employeeId: vars.originalRequest.employeeId,
  firstName: vars.originalRequest.firstName,
  lastName: vars.originalRequest.lastName,
  department: vars.originalRequest.department,
  employmentType: vars.employmentType,
  benefits: vars.benefits,
  correlationId: vars.correlationId
}]]></ee:set-payload>
							</ee:message>
						</ee:transform>
						<http:request method="POST" doc:name="Request" doc:id="64005ecb-0e6a-4a5e-9543-251ad25b56cf" config-ref="HTTP_Request_configuration2" path="/payroll/employees" target="payrollResponse"/>
						<ee:transform doc:name="Transform Message" doc:id="9dfcb8a1-db01-4df6-8103-9076cabcae5c" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  status: "SUCCESS",
  employeeId: vars.originalRequest.employeeId,
  payrollProfileId: vars.payrollResponse.payrollProfileId,
  benefits: vars.benefits,
  correlationId: vars.correlationId
}]]></ee:set-payload>
							</ee:message>
						</ee:transform>
						<os:store doc:name="Store" doc:id="a7808e07-ffdb-4d06-9057-23c14313faaa" key="#[vars.originalRequest.employeeId]"/>
					</otherwise>
				</choice>
			</otherwise>
		</choice>
		<error-handler >
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="4610b0cc-6724-407d-9be9-6a2e2e7396b5" type="APP:DUPLICATE_EMPLOYEE">
				<set-variable value="409" doc:name="Set Variable" doc:id="1b2f9316-6ebc-4380-ad51-1e9c70088fcf" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="e0d5c348-814b-45e8-bc2a-7df73ecb244f" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"status": "ERROR", "message": "Unexpected error", "correlationId": vars.correlationId
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</on-error-continue>
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="d64c6c41-9e95-497d-a891-ac4730589837" type="APP:INELIGIBLE_EMPLOYEE">
				<set-variable value="422" doc:name="Set Variable" doc:id="5378032a-799c-4116-a934-ed9cbc6fcc4b" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="960e2e49-e3df-422e-912f-89585a975cc0" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"status": "ERROR", "message": "Unexpected error", "correlationId": vars.correlationId
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</on-error-continue>
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="2bd879a8-284a-4850-9bdd-f01c5917ba67" type="ANY">
				<set-variable value="500" doc:name="Set Variable" doc:id="1b97e9f1-d71d-4c36-baaa-c8e7946aff24" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="b8d61f08-fbe5-4177-9ad7-263ca66b8f35" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"status": "ERROR", "message": "Unexpected error", "correlationId": vars.correlationId
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</on-error-continue>
		</error-handler>
	</flow>
</mule>
